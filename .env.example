# Telcenter Base Service Configuration
# Copy this file to .env and fill in actual values

# =============================================================================
# RabbitMQ Configuration
# =============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# =============================================================================
# MongoDB Configuration
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=telcenter_core_knowledge

# =============================================================================
# SeaweedFS Configuration
# =============================================================================
SEAWEED_MASTER_URL=http://localhost:9333

# =============================================================================
# S03 Knowledge Service Configuration
# =============================================================================

# A08 Event Consumer - receives validated knowledge from S05
KNOWLEDGE_STORE_EVENT_QUEUE=knowledge_store_events

# A01 RPC Client - sends knowledge updates to S02 AI Agent
TELCENTER_AI_AGENT_REQUESTS_QUEUE=telcenter_ai_agent_requests
TELCENTER_AI_AGENT_RESPONSES_QUEUE=telcenter_ai_agent_responses

# =============================================================================
# Additional Service Configurations (for future services)
# =============================================================================

# S05 Knowledge Validator Service
# VALIDATION_TASK_QUEUE=validation_tasks
# VALIDATION_DB_NAME=telcenter_core_validator

# S11 Partner Local Knowledge Service
# PARTNER_KNOWLEDGE_DB_NAME=telcenter_partner_knowledge

# S12 Partner Knowledge Update Service
# SUBMISSION_DB_NAME=telcenter_partner_submissions

# S15 File Importing AI Agent
# IMPORT_FILE_REQUESTS_QUEUE=import_file_requests
# IMPORT_FILE_RESPONSES_QUEUE=import_file_responses
